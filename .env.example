# Copie para `.env` e preencha. Em produção, cadastre estas variáveis no painel do Coolify.

# Banco (Postgres). Em dev, o do compose.yml: postgresql://bookora:bookora@localhost:5432/bookora
DATABASE_URL=

# Auth.js
# Gere com: npx auth secret
AUTH_SECRET=
# Obrigatória atrás de proxy (Coolify). Em dev pode ficar de fora
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# E-mail do login (Resend). O domínio do remetente precisa estar verificado no Resend
AUTH_RESEND_KEY=
EMAIL_FROM=Bookora <nao-responda@mail.usebookora.com.br>

# Stripe (chaves, webhook e price do mesmo modo: Test ou Live)
STRIPE_SECRET_KEY=
# Em dev, vem do `pnpm stripe:listen`. Em produção, do endpoint
# https://usebookora.com.br/api/stripe/webhook (Dashboard Stripe → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=
# ID do price mensal do plano Pro (Dashboard Stripe → Produtos)
STRIPE_PRICE_PRO=

# URL pública do app. Entra no bundle no build: defina antes de buildar
NEXT_PUBLIC_APP_URL=https://usebookora.com.br
