{
  "$description": "Design tokens do Bookora (formato W3C Design Tokens / DTCG). Só define as variáveis que o CSS vai usar (cores, fontes, espaçamentos, raios, sombras, animações). Não define layout nem componentes. Tokens semânticos referenciam primitivos com {caminho.do.token}.",

  "color": {
    "$type": "color",

    "neutral": {
      "0": { "$value": "#FFFFFF" },
      "50": { "$value": "#FAFAFA" },
      "100": { "$value": "#F4F4F5" },
      "200": { "$value": "#E4E4E7" },
      "300": { "$value": "#D4D4D8" },
      "400": { "$value": "#A1A1AA" },
      "500": { "$value": "#71717A" },
      "600": { "$value": "#52525B" },
      "700": { "$value": "#3F3F46" },
      "800": { "$value": "#27272A" },
      "900": { "$value": "#18181B" },
      "950": { "$value": "#09090B" }
    },

    "green": {
      "50": { "$value": "#F0FDF4" },
      "100": { "$value": "#DCFCE7" },
      "500": { "$value": "#22C55E" },
      "600": { "$value": "#16A34A" },
      "700": { "$value": "#15803D" }
    },
    "amber": {
      "50": { "$value": "#FFFBEB" },
      "100": { "$value": "#FEF3C7" },
      "500": { "$value": "#F59E0B" },
      "600": { "$value": "#D97706" },
      "700": { "$value": "#B45309" }
    },
    "red": {
      "50": { "$value": "#FEF2F2" },
      "100": { "$value": "#FEE2E2" },
      "500": { "$value": "#EF4444" },
      "600": { "$value": "#DC2626" },
      "700": { "$value": "#B91C1C" }
    },
    "blue": {
      "50": { "$value": "#EFF6FF" },
      "100": { "$value": "#DBEAFE" },
      "500": { "$value": "#3B82F6" },
      "600": { "$value": "#2563EB" },
      "700": { "$value": "#1D4ED8" }
    },

    "brand": {
      "$description": "Cor da marca. Na página pública (/{slug}) é sobrescrita em runtime pela cor escolhida pelo estabelecimento (--color-brand). 'hover', 'subtle' e 'on' devem ser derivados dela (ex.: color-mix) e 'on' escolhido por contraste.",
      "default": {
        "$value": "#4F46E5",
        "$description": "Cor do Bookora (landing, login, dashboard) e fallback da página pública."
      },
      "hover": { "$value": "#4338CA" },
      "subtle": { "$value": "#EEF2FF" },
      "on": {
        "$value": "#FFFFFF",
        "$description": "Texto/ícone sobre a cor da marca."
      }
    },

    "brandPresets": {
      "$description": "Opções de cor oferecidas em Configurações para a página pública.",
      "indigo": { "$value": "#4F46E5" },
      "blue": { "$value": "#2563EB" },
      "teal": { "$value": "#0D9488" },
      "green": { "$value": "#16A34A" },
      "orange": { "$value": "#EA580C" },
      "rose": { "$value": "#E11D48" },
      "purple": { "$value": "#9333EA" },
      "graphite": { "$value": "#27272A" }
    },

    "bg": {
      "canvas": {
        "$value": "{color.neutral.50}",
        "$description": "Fundo da página."
      },
      "surface": {
        "$value": "{color.neutral.0}",
        "$description": "Cards, modais, inputs."
      },
      "subtle": {
        "$value": "{color.neutral.100}",
        "$description": "Hover, áreas secundárias."
      },
      "inverse": { "$value": "{color.neutral.900}" }
    },

    "text": {
      "primary": { "$value": "{color.neutral.900}" },
      "secondary": { "$value": "{color.neutral.600}" },
      "muted": { "$value": "{color.neutral.500}" },
      "disabled": { "$value": "{color.neutral.400}" },
      "inverse": { "$value": "{color.neutral.0}" },
      "link": { "$value": "{color.brand.default}" }
    },

    "border": {
      "default": { "$value": "{color.neutral.200}" },
      "strong": { "$value": "{color.neutral.300}" },
      "focus": { "$value": "{color.brand.default}" }
    },

    "status": {
      "success": {
        "$description": "Agendamento confirmado, link copiado.",
        "bg": { "$value": "{color.green.50}" },
        "fg": { "$value": "{color.green.700}" },
        "border": { "$value": "{color.green.100}" },
        "solid": { "$value": "{color.green.600}" }
      },
      "warning": {
        "$description": "Uso do plano perto do limite, limite mensal atingido.",
        "bg": { "$value": "{color.amber.50}" },
        "fg": { "$value": "{color.amber.700}" },
        "border": { "$value": "{color.amber.100}" },
        "solid": { "$value": "{color.amber.500}" }
      },
      "danger": {
        "$description": "Erros, excluir serviço, plano expirado.",
        "bg": { "$value": "{color.red.50}" },
        "fg": { "$value": "{color.red.700}" },
        "border": { "$value": "{color.red.100}" },
        "solid": { "$value": "{color.red.600}" }
      },
      "info": {
        "bg": { "$value": "{color.blue.50}" },
        "fg": { "$value": "{color.blue.700}" },
        "border": { "$value": "{color.blue.100}" },
        "solid": { "$value": "{color.blue.600}" }
      }
    },

    "slot": {
      "$description": "Estados de um horário (bloco de 30 min) na página pública.",
      "available": { "$value": "{color.neutral.0}" },
      "hover": { "$value": "{color.brand.subtle}" },
      "selected": { "$value": "{color.brand.default}" },
      "unavailable": { "$value": "{color.neutral.100}" }
    },

    "overlay": {
      "$value": "#09090B80",
      "$description": "Fundo atrás de modais (neutral.950 a 50%)."
    },
    "skeleton": { "$value": "{color.neutral.200}" }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    },

    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },

    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem", "$description": "12px" },
      "sm": { "$value": "0.875rem", "$description": "14px" },
      "md": {
        "$value": "1rem",
        "$description": "16px — mínimo em inputs para evitar zoom no iOS"
      },
      "lg": { "$value": "1.125rem", "$description": "18px" },
      "xl": { "$value": "1.25rem", "$description": "20px" },
      "2xl": { "$value": "1.5rem", "$description": "24px" },
      "3xl": { "$value": "1.875rem", "$description": "30px" },
      "4xl": { "$value": "2.25rem", "$description": "36px" },
      "5xl": { "$value": "3rem", "$description": "48px — landing" }
    },

    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "snug": { "$value": 1.35 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.65 }
    },

    "letterSpacing": {
      "$type": "dimension",
      "tight": { "$value": "-0.02em" },
      "normal": { "$value": "0em" },
      "wide": { "$value": "0.04em" }
    },

    "numeric": {
      "tabular": {
        "$type": "other",
        "$value": "tabular-nums",
        "$description": "font-variant-numeric para horários, preços e contadores de uso."
      }
    }
  },

  "space": {
    "$type": "dimension",
    "$description": "Escala de 4px.",
    "0": { "$value": "0" },
    "0.5": { "$value": "0.125rem" },
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" },
    "20": { "$value": "5rem" },
    "24": { "$value": "6rem" }
  },

  "size": {
    "$type": "dimension",
    "control": {
      "sm": { "$value": "2rem" },
      "md": { "$value": "2.5rem" },
      "lg": { "$value": "3rem" }
    },
    "touchTarget": {
      "$value": "2.75rem",
      "$description": "44px, alvo mínimo de toque."
    },
    "icon": {
      "sm": { "$value": "1rem" },
      "md": { "$value": "1.25rem" },
      "lg": { "$value": "1.5rem" }
    },
    "avatar": {
      "$description": "Imagem de perfil do estabelecimento.",
      "sm": { "$value": "2rem" },
      "md": { "$value": "3rem" },
      "lg": { "$value": "5rem" },
      "xl": { "$value": "7.5rem" }
    },
    "container": {
      "narrow": {
        "$value": "30rem",
        "$description": "Página pública e login."
      },
      "md": { "$value": "48rem" },
      "wide": { "$value": "75rem", "$description": "Dashboard e landing." }
    },
    "sidebar": { "$value": "15rem" }
  },

  "radius": {
    "$type": "dimension",
    "none": { "$value": "0" },
    "sm": { "$value": "0.25rem" },
    "md": { "$value": "0.5rem" },
    "lg": { "$value": "0.75rem" },
    "xl": { "$value": "1rem" },
    "2xl": { "$value": "1.5rem" },
    "full": { "$value": "9999px" }
  },

  "border": {
    "width": {
      "$type": "dimension",
      "thin": { "$value": "1px" },
      "thick": { "$value": "2px" }
    }
  },

  "shadow": {
    "$type": "shadow",
    "xs": {
      "$value": {
        "color": "#0000000D",
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0"
      }
    },
    "sm": {
      "$value": [
        {
          "color": "#0000000F",
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0"
        },
        {
          "color": "#0000000A",
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0"
        }
      ]
    },
    "md": {
      "$value": [
        {
          "color": "#00000014",
          "offsetX": "0",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "-2px"
        },
        {
          "color": "#0000000A",
          "offsetX": "0",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "-2px"
        }
      ]
    },
    "lg": {
      "$value": [
        {
          "color": "#0000001A",
          "offsetX": "0",
          "offsetY": "12px",
          "blur": "24px",
          "spread": "-4px"
        },
        {
          "color": "#0000000A",
          "offsetX": "0",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "-4px"
        }
      ]
    },
    "focus": {
      "$value": {
        "color": "{color.border.focus}",
        "offsetX": "0",
        "offsetY": "0",
        "blur": "0",
        "spread": "3px"
      },
      "$description": "Anel de foco (:focus-visible). Usar com opacidade ~35% sobre a cor da marca."
    }
  },

  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.5 },
    "muted": { "$value": 0.7 }
  },

  "zIndex": {
    "$type": "number",
    "base": { "$value": 0 },
    "dropdown": { "$value": 10 },
    "sticky": { "$value": 20 },
    "overlay": { "$value": 40 },
    "modal": { "$value": 50 },
    "toast": { "$value": 60 }
  },

  "breakpoint": {
    "$type": "dimension",
    "$description": "Mobile-first (min-width).",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "0ms" },
      "fast": {
        "$value": "120ms",
        "$description": "Hover, troca de cor, press."
      },
      "base": {
        "$value": "200ms",
        "$description": "Abrir/fechar dropdown, seleção de slot."
      },
      "slow": {
        "$value": "320ms",
        "$description": "Modais, troca de etapa no fluxo de agendamento."
      },
      "slower": {
        "$value": "480ms",
        "$description": "Tela de agradecimento, check de confirmação."
      },
      "loop": { "$value": "1200ms", "$description": "Skeleton e spinner." }
    },

    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [0.2, 0, 0, 1],
        "$description": "Padrão para a maioria das transições."
      },
      "enter": {
        "$value": [0, 0, 0.2, 1],
        "$description": "Elementos entrando (desacelera)."
      },
      "exit": {
        "$value": [0.4, 0, 1, 1],
        "$description": "Elementos saindo (acelera)."
      },
      "emphasized": {
        "$value": [0.34, 1.56, 0.64, 1],
        "$description": "Leve overshoot, para confirmações."
      },
      "linear": { "$value": [0, 0, 1, 1] }
    },

    "transition": {
      "$type": "transition",
      "colors": {
        "$value": {
          "duration": "{motion.duration.fast}",
          "delay": "0ms",
          "timingFunction": "{motion.easing.standard}"
        },
        "$description": "color, background-color, border-color"
      },
      "transform": {
        "$value": {
          "duration": "{motion.duration.base}",
          "delay": "0ms",
          "timingFunction": "{motion.easing.standard}"
        }
      },
      "enter": {
        "$value": {
          "duration": "{motion.duration.slow}",
          "delay": "0ms",
          "timingFunction": "{motion.easing.enter}"
        }
      },
      "exit": {
        "$value": {
          "duration": "{motion.duration.base}",
          "delay": "0ms",
          "timingFunction": "{motion.easing.exit}"
        }
      }
    },

    "keyframes": {
      "$type": "other",
      "$description": "@keyframes que serão definidos no CSS global. Valores em sintaxe CSS.",
      "fade-in": { "$value": { "from": "opacity: 0", "to": "opacity: 1" } },
      "fade-out": { "$value": { "from": "opacity: 1", "to": "opacity: 0" } },
      "slide-up": {
        "$value": {
          "from": "opacity: 0; transform: translateY(8px)",
          "to": "opacity: 1; transform: translateY(0)"
        }
      },
      "slide-down": {
        "$value": {
          "from": "opacity: 0; transform: translateY(-8px)",
          "to": "opacity: 1; transform: translateY(0)"
        }
      },
      "scale-in": {
        "$value": {
          "from": "opacity: 0; transform: scale(0.96)",
          "to": "opacity: 1; transform: scale(1)"
        }
      },
      "pop": {
        "$value": {
          "0%": "transform: scale(0.6); opacity: 0",
          "60%": "transform: scale(1.08); opacity: 1",
          "100%": "transform: scale(1)"
        },
        "$description": "Ícone de sucesso na tela de agradecimento."
      },
      "check-draw": {
        "$value": {
          "from": "stroke-dashoffset: 24",
          "to": "stroke-dashoffset: 0"
        },
        "$description": "Desenho do traço do check (stroke-dasharray: 24)."
      },
      "shake": {
        "$value": {
          "0%, 100%": "transform: translateX(0)",
          "25%": "transform: translateX(-4px)",
          "75%": "transform: translateX(4px)"
        },
        "$description": "Erro de validação ou horário que acabou de ser ocupado."
      },
      "pulse": {
        "$value": { "0%, 100%": "opacity: 1", "50%": "opacity: 0.5" },
        "$description": "Skeleton de carregamento."
      },
      "spin": {
        "$value": {
          "from": "transform: rotate(0deg)",
          "to": "transform: rotate(360deg)"
        }
      }
    },

    "animation": {
      "$type": "other",
      "$description": "Atalhos para a propriedade CSS animation.",
      "fade-in": {
        "$value": "fade-in {motion.duration.base} {motion.easing.enter} both"
      },
      "fade-out": {
        "$value": "fade-out {motion.duration.base} {motion.easing.exit} both"
      },
      "slide-up": {
        "$value": "slide-up {motion.duration.slow} {motion.easing.enter} both"
      },
      "slide-down": {
        "$value": "slide-down {motion.duration.base} {motion.easing.enter} both"
      },
      "scale-in": {
        "$value": "scale-in {motion.duration.base} {motion.easing.enter} both"
      },
      "pop": {
        "$value": "pop {motion.duration.slower} {motion.easing.emphasized} both"
      },
      "check-draw": {
        "$value": "check-draw {motion.duration.slower} {motion.easing.standard} 150ms both"
      },
      "shake": {
        "$value": "shake {motion.duration.slow} {motion.easing.standard}"
      },
      "pulse": {
        "$value": "pulse {motion.duration.loop} {motion.easing.standard} infinite"
      },
      "spin": { "$value": "spin 800ms {motion.easing.linear} infinite" }
    },

    "stagger": {
      "$type": "duration",
      "$description": "Atraso entre itens de uma lista animada (serviços, horários).",
      "list": { "$value": "40ms" }
    },

    "reducedMotion": {
      "$type": "other",
      "$value": "Em @media (prefers-reduced-motion: reduce), usar motion.duration.instant e desativar slide/scale/shake/pop; manter só fade e spin.",
      "$description": "Regra de acessibilidade."
    }
  }
}
